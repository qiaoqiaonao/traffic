<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志配置说明：
  - 控制台：输出 INFO 及以上级别（启动信息、HTTP请求），隐藏 SQL/框架噪音
  - 文件 logs/debug.log：保存 DEBUG 及以上完整日志（含SQL、业务逻辑），每次启动自动清空旧日志
  - 文件 logs/error.log：仅保存 WARN 及以上日志，用于快速定位错误
  - MyBatis SQL 日志只写入文件，不输出到控制台
-->
<configuration>

    <!-- 彩色控制台输出模式 -->
    <property name="CONSOLE_PATTERN"
              value="%d{HH:mm:ss.SSS} %highlight(%-5level) %cyan(%-40logger{36}) - %msg%n"/>

    <!-- 文件日志输出模式（含完整信息） -->
    <property name="FILE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%-16thread] %-40logger{36} - %msg%n"/>

    <!-- ==================== 控制台输出（INFO 及以上） ==================== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ==================== 完整日志文件（DEBUG 及以上，每次启动清空） ==================== -->
    <appender name="DEBUG_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/debug.log</file>
        <!-- append=false：每次启动清空旧日志 -->
        <append>false</append>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/debug-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxHistory>3</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
            <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>50MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ==================== 错误日志文件（WARN 及以上，每次启动清空） ==================== -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/error.log</file>
        <append>false</append>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/error-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxHistory>7</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
            <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>20MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ==================== 根日志级别：控制台 + 文件 ==================== -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="DEBUG_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>

    <!-- ==================== 业务模块：文件记录 DEBUG ==================== -->
    <logger name="com.traffic" level="DEBUG" additivity="true">
        <appender-ref ref="DEBUG_FILE"/>
    </logger>

    <!-- ==================== MyBatis SQL：只写入文件，不输出到控制台 ==================== -->
    <logger name="com.traffic.mapper" level="DEBUG" additivity="false">
        <appender-ref ref="DEBUG_FILE"/>
    </logger>
    <logger name="com.baomidou.mybatisplus" level="DEBUG" additivity="false">
        <appender-ref ref="DEBUG_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </logger>

    <!-- ==================== 框架日志：降低噪音（控制台上只显示 WARN+） ==================== -->
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.springframework.boot" level="INFO"/>
    <logger name="org.springframework.jdbc" level="WARN"/>
    <logger name="org.apache.ibatis" level="WARN"/>
    <logger name="io.lettuce.core" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.apache.catalina" level="INFO"/>
    <logger name="org.apache.coyote" level="INFO"/>

</configuration>